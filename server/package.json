{
  "name": "private-hr-rag-server",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Air-gapped RAG backend: local embeddings + local vector index + Foundry Local SSE streaming",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/index.ts",
    "start": "tsx --env-file-if-exists=../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "ingest": "tsx ../scripts/ingest.ts",
    "test:rag": "tsx ../scripts/test-rag.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:exe": "node ../scripts/build-exe.mjs",
    "eval": "tsx ../scripts/eval-answers.ts",
    "test:policy": "tsx ../scripts/test-policy.ts",
    "test": "npm run test:policy && npm run test:evidence && npm run test:documents && npm run test:formats && npm run test:audit && npm run test:rag && npm run test:pdf",
    "pdf": "node ../scripts/md-to-pdf.mjs",
    "test:pdf": "tsx ../scripts/test-pdf.ts",
    "ingest:pdf": "node -e \"process.env.CORPUS_DIR=require('path').resolve('../data/corpus-pdf');require('child_process').execFileSync(process.platform==='win32'?'npx.cmd':'npx',['tsx','../scripts/ingest.ts'],{stdio:'inherit',env:process.env})\"",
    "test:evidence": "tsx ../scripts/test-evidence.ts",
    "compare": "tsx ../scripts/compare-models.ts",
    "test:documents": "tsx ../scripts/test-documents.ts",
    "test:formats": "tsx ../scripts/test-formats.ts",
    "fixtures": "node ../scripts/make-fixtures.mjs",
    "test:audit": "tsx ../scripts/test-corpus-audit.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "express": "^5.1.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
