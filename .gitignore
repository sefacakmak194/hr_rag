node_modules/
dist/
dist-app/
.sea-build/

# Makineye ozel ayarlar (.env.example izlenir)
.env.local

# Uretilen vektor indeksi — `npm run ingest` ile yeniden olusturulur
data/vectors.db

# Ileri tarihli politika surumlerinin bekleme dizini (Sprint 2).
# Calisma zamani durumudur: dosyalar yururluk tarihi gelince korpusa TASINIR.
# Depoya girerse her klonda "bekleyen surum" gorunur ve indeks yanlis kurulur.
data/corpus-pending/

# Denetim imzalama OZEL ANAHTARI — asla depoya girmemeli.
# Acik anahtar (audit-public.pem) paylasilabilir ama makineye ozel uretildigi
# icin o da izlenmiyor; denetciye elle verilir.
data/audit-signing.key
data/audit-public.pem

# Imzali denetim arsivleri — calisma zamani ciktisi.
# ASIL SAVUNMA bunlarin makineden DISARI cikarilmasidir; depoya konmasi
# (ozellikle acik olmayan bir depoya) bir yedek stratejisi degildir.
data/arsiv/

# Embedding modeli onbellegi
.cache/

# tesseract.js, calisma dizinine dil verisi onbellegi yazar. Kaynak kopya
# server/vendor/tessdata/ altinda ve IZLENIR (air-gapped OCR icin sart).
server/*.traineddata

# TypeScript artimli derleme onbellegi — makineye ozel mutlak yollar tasir
client/tsconfig.tsbuildinfo

# Isletim sistemi / editor artiklari
Thumbs.db
.DS_Store
*.log

# NOT: scripts/fixtures/ BILINCLI olarak izleniyor. Uretici betik
# (make-fixtures.mjs) taranmis PDF icin Chrome'a ve Windows yollarina bagli;
# CI'da uretilemez. Dosyalar 81 KB, test girdisi olarak depoda tutuluyor.

# Model karsilastirmasinin ara kaydi — kosum bitince silinir
data/.compare-checkpoint.json

# Tarama ciktilari. Rapor (TARAMA-RAPORU.md) IZLENIR — bulgu odur; yanindaki
# veritabani kopyasi, ham JSON ve CSV ise yeniden uretilebilir ve buyuktur.
data/tarama/tarama.db
data/tarama/tarama-ham.json
data/tarama/tarama.csv

# Saha denetimi ciktilari. Rapor (SAHA-RAPORU.md) IZLENIR — bulgu odur; ham
# JSON her kosumda yeniden uretilir ve buyuktur.
data/saha/saha-ham.json
