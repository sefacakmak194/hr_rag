# Bu dosyayi `.env.local` olarak kopyalayip makinenize gore duzenleyin.
# server `tsx --env-file-if-exists=../.env.local` ile baslatildigi icin otomatik okunur.

# --- Foundry Local ---
# Uc nokta normalde `foundry server status -o json` ile OTOMATIK kesfedilir
# (Foundry 0.10+ her baslatmada rastgele port atar). Yalnizca kesfi atlamak
# isterseniz elle verin:
# FOUNDRY_BASE_URL=http://127.0.0.1:57617/v1

# Kullanilacak model. Takma ad (phi-3.5-mini) yerine TAM VARYANT KIMLIGI vermek
# onerilir: /v1/models onbellekteki tum varyantlari listeler ve makineye gore
# bir kismi bozuk olabilir.
#
# Varyantlari gormek icin:  foundry model info phi-3.5-mini
# FOUNDRY_MODEL=Phi-3.5-mini-instruct-generic-cpu

# --- Backend ---
# PORT=5273

# --- Embedding ---
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Modeli indirdikten sonra tam cevrim disi calismayi zorlar:
# TRANSFORMERS_OFFLINE=1

# --- Alaka kapisi (scripts/calibrate.ts ile yeniden olculebilir) ---
# TOP_K=3
# SIMILARITY_THRESHOLD=0.853
# RELEVANCE_MARGIN=0.038
# CONTEXT_BAND=0.05
